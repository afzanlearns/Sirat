# Sirat Backend — Environment Variables
# Copy this to .env and fill in your values.

GROQ_API_KEY=your_groq_api_key_here
PORT=3001

# Supabase (optional). When set, user progress persists to Postgres under RLS,
# with the server acting AS the user via their forwarded anon-auth JWT.
# Use the PUBLISHABLE key (sb_publishable_...), NOT the service_role secret.
# Leave blank to fall back to the local JSON file store (zero-config).
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxx

# HidayahAI RAG service for the Ask section (see ../rag). Default assumes local.
RAG_URL=http://localhost:8000
